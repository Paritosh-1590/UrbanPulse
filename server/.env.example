# Required: local MongoDB or MongoDB Atlas connection string
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/urbanpulse
# Replace with a random secret of at least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_TTL_SECONDS=604800
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional. When unavailable, Express uses its local keyword classifier.
ML_SERVICE_URL=http://127.0.0.1:8000
# Only used by npm run seed:admin; choose your own values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
